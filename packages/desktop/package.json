{
  "name": "@kiroshi/desktop",
  "version": "1.15.0",
  "private": true,
  "description": "Kiroshi — cliente desktop",
  "author": "Kiroshi",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/baixar-modelos.mjs --tolerante && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "preview": "electron-vite preview",
    "dist:win": "node scripts/baixar-modelos.mjs --verificar && electron-vite build && electron-builder --win --publish never",
    "dist:dir": "node scripts/baixar-modelos.mjs --verificar && electron-vite build && electron-builder --dir --publish never",
    "modelos": "node scripts/baixar-modelos.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "deepfilternet3-noise-filter": "1.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@kiroshi/shared": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "livekit-client": "^2.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
