{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@kiroshi/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "electron/preload.ts", "../shared/src/**/*"],
  "exclude": ["../shared/src/**/*.test.ts"]
}
