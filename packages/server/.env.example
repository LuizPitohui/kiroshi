# Copie para .env e preencha. O .env nunca vai para o git.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres. Em producao aponte para o host do container.
DATABASE_URL="postgresql://kiroshi_app:SENHA@127.0.0.1:5432/kiroshi_dev?schema=public&connection_limit=10"

# Assine com pelo menos 32 bytes aleatorios:
#   openssl rand -base64 48
JWT_SECRET="troque-isto"

# Opcional. Sem REDIS_URL o servidor usa um barramento em memoria, que basta
# para um unico processo. Defina apenas se for rodar mais de uma instancia.
# REDIS_URL=redis://127.0.0.1:6379

# SFU de voz e video (LiveKit).
LIVEKIT_URL=wss://voice.exemplo.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Servidores TURN extras, em JSON, quando o caminho direto nao funciona:
# [{"urls":["turn:host:3478?transport=tcp"],"username":"u","credential":"p"}]
# TURN_SERVERS=
# Forca todo o trafego de midia pelo relay. Ative so se o P2P/SFU direto falhar.
# FORCE_TURN_RELAY=false

# Armazenamento de anexos no disco local.
STORAGE_DIR=./uploads
# URL publica usada para montar os links de anexo.
PUBLIC_BASE_URL=https://order.exemplo.com

# true: qualquer pessoa cria conta. false: so com codigo de convite.
ALLOW_OPEN_REGISTRATION=false

# Origens permitidas no CORS, separadas por virgula. O app desktop nao precisa.
# CORS_ORIGINS=https://order.exemplo.com

# ---------------------------------------------------------------------------
# Login com Google (opcional)
# ---------------------------------------------------------------------------
# Sem estes dois, o botao "Entrar com Google" simplesmente nao aparece e o
# servidor sobe igual. Crie um cliente OAuth do tipo "Aplicativo da Web" em
# console.cloud.google.com, com escopos openid, userinfo.email e
# userinfo.profile, e cadastre este endereco de redirecionamento:
#
#   <PUBLIC_BASE_URL>/api/v1/auth/google/callback
#
# O segredo fica SO aqui: e o servidor que troca o codigo do Google pelo
# token, justamente para nao embutir segredo no executavel do cliente.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Para onde mandar pedido sobre dados pessoais. Aparece na pagina publica de
# privacidade. Sem ele, a pagina diz para falar com quem administra pelo
# proprio aplicativo.
# CONTATO_PRIVACIDADE=

# Prova de posse do dominio para o Search Console do Google. Nao e segredo: o
# proposito dele e ficar visivel no HTML publico. Ha um valor embutido no
# codigo para o dominio de origem; defina aqui para sobrescrever em outro.
# GOOGLE_SITE_VERIFICATION=
