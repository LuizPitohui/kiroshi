# Imagem da API do Order.
#
# Duas etapas: a primeira instala tudo e compila; a segunda leva apenas o que
# roda. O resultado nao carrega typescript, prisma CLI nem fontes.

FROM node:22-bookworm-slim AS build

WORKDIR /app

# OpenSSL e exigido pelo engine do Prisma; python/build-essential servem para
# as dependencias nativas (argon2, sharp) quando nao ha binario pronto.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl python3 build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Copia so os manifestos primeiro: enquanto eles nao mudarem, o docker
# reaproveita a camada de instalacao mesmo que o codigo mude.
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/desktop/package.json packages/desktop/

# O cliente desktop nao entra na imagem do servidor: electron sozinho passa de
# 200 MB e nao serve para nada aqui.
RUN npm pkg delete workspaces \
 && npm pkg set workspaces[0]="packages/shared" workspaces[1]="packages/server" \
 && npm install --include=dev --ignore-scripts \
 && npm rebuild argon2 sharp @prisma/client prisma

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/server packages/server

RUN npm run build -w @kiroshi/shared \
 && npx prisma generate --schema packages/server/prisma/schema.prisma \
 && npx tsc -p packages/server/tsconfig.json

# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data/uploads \
 && chown -R node:node /data

ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/server/dist ./packages/server/dist
COPY --from=build /app/packages/server/package.json ./packages/server/package.json
COPY --from=build /app/packages/server/prisma ./packages/server/prisma

# Nao roda como root: se algo for comprometido, o alcance e menor.
USER node

EXPOSE 4000

# Aplica as migracoes antes de subir. Se o banco estiver indisponivel, o
# container falha e o restart do compose tenta de novo.
CMD ["sh", "-c", "npx prisma migrate deploy --schema packages/server/prisma/schema.prisma && node packages/server/dist/index.js"]
